# Database connection for external MySQL
DB_HOST=your-db-hostname
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# SMTP (optional: enable to send emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_ENCRYPTION=ssl
SMTP_FROM=you@example.com
SMTP_FROM_NAME="Your Name or Brand"

# Optional: if your MySQL requires SSL, set to preferred/required and mount certs as needed
# DB_SSL_MODE=preferred
